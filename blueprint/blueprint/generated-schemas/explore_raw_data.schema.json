{
  "description": "Explore raw data configuration.",
  "properties": {
    "source_csv": {
      "default": "include/moon_missions.csv",
      "description": "Path to the CSV file relative to the project root",
      "title": "Source Csv",
      "type": "string"
    },
    "num_rows": {
      "default": 5,
      "description": "Number of sample rows to display in the logs",
      "minimum": 1,
      "maximum": 100,
      "title": "Num Rows",
      "type": "integer"
    },
    "print_schema": {
      "default": true,
      "description": "Print the column names and types before the sample rows",
      "title": "Print Schema",
      "type": "boolean"
    },
    "blueprint": {
      "type": "string",
      "const": "explore_raw_data",
      "description": "The blueprint template to use"
    },
    "version": {
      "type": "integer",
      "const": 1,
      "description": "The blueprint version"
    }
  },
  "required": [
    "blueprint",
    "version"
  ],
  "title": "Explore raw data",
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#"
}
